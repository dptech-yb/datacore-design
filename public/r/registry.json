{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "datacore",
  "homepage": "https://design.datacore.dp.cd.mba",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "DataCore 主题",
      "description": "DataCore 令牌：浅/深两套 CSS 变量 + Tailwind 3 preset。先装它，再装组件。",
      "dependencies": [
        "tailwindcss-animate",
        "@fontsource-variable/inter"
      ],
      "files": [
        {
          "path": "styles/tokens.css",
          "type": "registry:file",
          "target": "src/styles/datacore-tokens.css"
        },
        {
          "path": "tailwind.preset.js",
          "type": "registry:file",
          "target": "datacore.preset.js"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn()",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button 按钮",
      "dependencies": [
        "@radix-ui/react-slot",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge 状态徽标",
      "dependencies": [
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "ui/badge.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card 卡片",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "ui/card.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input / Label 输入框",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "ui/input.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "select",
      "type": "registry:ui",
      "title": "Select 下拉选择",
      "dependencies": [
        "@radix-ui/react-select",
        "lucide-react"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "ui/select.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "tabs",
      "type": "registry:ui",
      "title": "Tabs 页签 / 分段控件",
      "dependencies": [
        "@radix-ui/react-tabs"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "ui/tabs.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "table",
      "type": "registry:ui",
      "title": "Table 表格（基础）",
