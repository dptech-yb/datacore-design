{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "datacore",
  "homepage": "https://design.datacore.dp.cd.mba",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "DataCore 主题",
      "description": "DataCore 令牌：浅/深两套 CSS 变量 + Tailwind 3 preset。先装它，再装组件。",
      "dependencies": [
        "tailwindcss-animate",
        "@fontsource-variable/inter"
      ],
      "files": [
        {
          "path": "styles/tokens.css",
          "type": "registry:file",
          "target": "src/styles/datacore-tokens.css"
        },
        {
          "path": "tailwind.preset.js",
          "type": "registry:file",
          "target": "datacore.preset.js"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn()",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
